{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "index.server.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "index.client.tsx",
    "client/**/*.ts",
    "client/**/*.tsx"
  ]
}
