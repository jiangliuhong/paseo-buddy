{
  "name": "paseo-buddy",
  "version": "0.1.7",
  "private": true,
  "description": "Native macOS floating companion for Paseo agents",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run runtime:build && node scripts/build-plugin.mjs",
    "runtime:build": "tsc -p tsconfig.runtime.json",
    "test": "npm run runtime:build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "native:build": "npm run runtime:build && node scripts/native.mjs build",
    "native:start": "npm run runtime:build && node scripts/native.mjs start",
    "native:check": "npm run runtime:build && node scripts/check-native.mjs",
    "daemon:check": "npm run runtime:build && node scripts/check-daemon.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.0",
    "react": "^19.0.0",
    "@types/react": "^19.0.0"
  },
  "dependencies": {
    "@getpaseo/client": "0.11.1",
    "@getpaseo/protocol": "0.11.1",
    "zod": "^4.4.3"
  }
}
